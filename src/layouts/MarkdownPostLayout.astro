---
const { frontmatter, postID } = Astro.props;
---

<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
</head>

<html lang="en">
  <div class="blog-post">
    <div class="head">
        <a href={`/posts/${postID}`} class="title">{frontmatter.title}</a>
        <span class="date">{frontmatter.pubDate.toString().slice(0,10)}</span>
    </div>
    <div class="info">
        <span class="description">{frontmatter.description}</span>
    </div>
    <div class="post-content">
      <slot />
    </div>
  </div>
</html>

<style>
  html {
    background-color: #030303;
  }
  .blog-post {
    display: flex;
    flex-direction: column;
    font-family: inherit;
    color: #f4ff54;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.4rem;
    border-bottom: 2px solid white;
  }
  .title {
    margin: .5rem;
    text-decoration: none;
    color: inherit;
  }
  .title:active {
    transform: translateY(1px);
  }
  .date {
    color: rgb(0, 207, 207);
    margin: .5rem;
  }
  .info {
    border-bottom: 2px solid white;
    margin-top: .5rem;
    font-size: 1.4rem;
    color: rgb(4, 214, 39);
  }
  .description {
    margin-left: .5rem;
  }
  .post-content {
    font-size: 1.2rem;
    color: white;
    margin: 0 .5rem;
  }
</style>