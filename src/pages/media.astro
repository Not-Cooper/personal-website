---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Home Page";
---
<BaseLayout pageTitle={pageTitle}>
    <div class="media-container">
        <div class="content-container">
            <div class="viewer-panel">
                <div id="viewer-placeholder">Click a thumbnail below to view the universe</div>
                <img id="large-viewer" src="" alt="Selected Astro Scene" style="display: none;">
                <p id="viewer-caption"></p>
            </div>
        </div>
        <div class="content-container">
            <div class="thumbnail-grid">
                <div class="thumb-wrapper">
                    <img class="thumb" 
                        src="/duck.jpg" 
                        data-large="/duck.jpg" 
                        data-caption="duck"
                        alt="duck">
                </div>
                <div class="thumb-wrapper">
                    <img class="thumb" 
                        src="/super_pets.png" 
                        data-large="/super_pets.png" 
                        data-caption="pets"
                        alt="pets">
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
.media-container {
    display: flex;
    flex: 1;
    gap: .5rem;
    margin: .2rem .5rem;
    min-height: 0;
}
.viewer-panel {
    display: flex;
    flex: 1;
    background-color: #1f2833;
    border: 2px solid #45f3ff33;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 15px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
}
#large-viewer {
    max-width: 100%;
    max-height: 500px;
    border-radius: 4px;
    object-fit: contain;
    animation: fadeIn 0.4s ease-in-out;
}
.thumbnail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 15px;
    justify-content: center;
}

.thumb-wrapper {
    overflow: hidden;
    border-radius: 6px;
    border: 2px solid #1f2833;
    cursor: pointer;
    transition: transform 0.2s, border-color 0.2s;
    height: 100px;
}

.thumb-wrapper:hover {
    transform: scale(1.05);
    border-color: #66fcf1;
}

.thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.thumb.active-thumb {
    border: 2px solid #66fcf1;
    box-shadow: 0 0 10px #66fcf1;
}
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const thumbnails = document.querySelectorAll(".thumb");
        const largeViewer = document.getElementById("large-viewer") as HTMLImageElement;
        const viewerPlaceholder = document.getElementById("viewer-placeholder");
        const viewerCaption = document.getElementById("viewer-caption");

        thumbnails.forEach(thumb => {
            thumb.addEventListener("click", () => {
                // 1. Get high-res URL and caption from data attributes
                const largeImgUrl = thumb.getAttribute("data-large") ?? "";
                const captionText = thumb.getAttribute("data-caption") ?? "";

                if (thumbnails && largeViewer && viewerPlaceholder && viewerCaption) {
                    // 2. Hide placeholder and update main viewer source
                    viewerPlaceholder.style.display = "none";
                    largeViewer.src = largeImgUrl;
                    largeViewer.style.display = "block";
                    
                    // 3. Update the caption text
                    viewerCaption.textContent = captionText;

                    // 4. Remove active visual indicators from all wrapper borders
                    thumbnails.forEach(t => t.parentElement?.classList.remove("active-thumb"));
                    
                    // 5. Add active styling to clicked thumbnail wrapper
                    if (thumb.parentElement) {
                        thumb.parentElement.classList.add("active-thumb");
                    }
                }
            });
        });
    });
</script>