---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import notavailable from '../assets/media/not-available.png';

const imageFiles = import.meta.glob('/src/assets/media/*.{jpeg,jpg,png,gif,webp}');

const images = await Promise.all(
    Object.values(imageFiles).map((image) => image())
)


const pageTitle = "Media";
---
<BaseLayout pageTitle={pageTitle}>
    <div class="media-container">
        <div class="content-container">
            <div class="viewer-panel">
                <img id="large-viewer" src={notavailable.src} alt="Selected Astro Scene"/>
            </div>
        </div>
        <div class="content-container">
            <div class="thumbnail-grid">
                {images.map((img: any) => 
                    <div class="thumb-wrapper">
                        <Image class="thumb" 
                            src={img.default} 
                            data-large={img.default.src}
                            data-caption={'image'}
                            alt={'image'}/> 
                    </div>
                )}
            </div>
        </div>
    </div>
</BaseLayout>

<style>
.media-container {
    display: flex;
    flex: 1;
    gap: .5rem;
    margin: .2rem .5rem;
    min-height: 0;
}
.viewer-panel {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
#large-viewer {
    height: 800px;
    width: auto;
    /* aspect-ratio: 1/1; */
}

.thumbnail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 15px;
    justify-content: center;
    margin: .5rem;
}
.thumb-wrapper {
    border: 4px solid var(--yellow);
    cursor: pointer;
    height: fit-content;
    width: fit-content;
}
 .thumb-wrapper:active {
    transform: translateY(1px);
}
.thumb {
    display: block;
    width: 20rem;
    height: 20rem;
    object-fit: cover;
}
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const thumbnails = document.querySelectorAll(".thumb");
        const largeViewer = document.getElementById("large-viewer") as HTMLImageElement;

        thumbnails.forEach(thumb => {
            thumb.addEventListener("click", () => {
                const largeImgUrl = thumb.getAttribute("data-large") ?? "";

                if (thumbnails && largeViewer) {
                    largeViewer.src = largeImgUrl;
                    largeViewer.style.display = "block";
                }
            });
        });
    });
</script>