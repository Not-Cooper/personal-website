---
import BaseLayout from '../layouts/BaseLayout.astro';
import Dropdown from '../components/Dropdown.astro';

const pageTitle = "Home Page";
---
<BaseLayout pageTitle={pageTitle}>
  <div class="content-container">
    <div class="dropdowns-container">
      <Dropdown collapsableID="1" isOpen="true" dropdownName="About Zach">
        <div class="about-zach">
          <h1>I Am Zach :)</h1>
          <p>I do software stuff a fair bit</p>
          <p>This is my personal website, inspired by the VOTV computer terminal</p>
          <p>Here, you can read some of my blog posts, meet my ducks (not real), and learn a bit about me</p>
        </div>
      </Dropdown>
      <Dropdown collapsableID="2" dropdownName="Timeline"></Dropdown>
      <Dropdown collapsableID="3" dropdownName="Ongoing Projects"></Dropdown>
      <Dropdown collapsableID="4" dropdownName="Links"></Dropdown>
    </div>
  </div>
</BaseLayout>

<style>
.about-zach {
  margin: 1rem;
  font-size: 1.5rem;
}
.dropdowns-container {
  width: 100%;
}
</style>