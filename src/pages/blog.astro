---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostsHolder from '../components/PostsHolder.astro';
import type { RenderResult } from 'astro:content';
import { getCollection, render, getEntry } from 'astro:content';
import '../assets/css/style.css';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

const allBlogPosts = await getCollection('blog');

// const renderedPosts: AstroComponentFactory[] = [];

// for (const post of allBlogPosts) {
//     const { Content } = await render(post)
//     renderedPosts.push(Content)
// }

// console.log(renderedPosts);

const pageTitle = "Blog";
---

<BaseLayout pageTitle={pageTitle}>
    <div class="emails-container">
        <div class="content-container">
            <div class="cards-holder">
                {allBlogPosts.map((post: any, index: number) => 
                    <button class="blog-card" blog-index={index.toString()}>
                        {"Author"} {"Description"} {"Date"}
                    </button>
                )}
            </div>
        </div>
        <div class="content-container">
            {allBlogPosts.map((post: any, index: number) => 
                <div id={index.toString()} class={`content-panel ${index === 0 ? 'active' : ''}`}>
                    <PostsHolder index={index} posts={allBlogPosts} />
                </div>
            )}
        </div>
    </div>
</BaseLayout>

<style>
    .emails-container {
        display: flex;
        flex: 1;
        gap: .5rem;
        margin: .2rem .5rem;
        min-height: 0;
    }
    .cards-holder {
        display: flex;
        flex-direction: column;
    }
    .blog-card {

    }
    .content-panel {
        display: none;
    }
    .content-panel.active {
        display: block;
    }
</style>

<script>
    const buttons = document.querySelectorAll('.blog-card');
    const panels = document.querySelectorAll('.content-panel');

    buttons.forEach(button => {
        button.addEventListener('click', () => {
            const targetId = button.getAttribute('blog-index');

            console.log(targetId)

            panels.forEach(panel => panel.classList.remove('active'));

            if (targetId) {
                const targetPanel = document.getElementById(targetId);
                if (targetPanel) targetPanel.classList.add('active');
            }
        });
    });
</script>