---
import { render} from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'project'>;
}

const { project } = Astro.props;

const projectData = project.data;

const { Content } = await render(project)
---

<div class="project-container">
    <div class="project-info">
        <div class="logo-holder">
            <img class="logo-image" src={projectData.projectIcon} alt="No Image"/>
        </div>
        <div class="info-holder">
            {projectData.title && 
                <span class="info">{projectData.title}</span>
            }
            {projectData.projectType && 
                <span class="info">{projectData.projectType}</span>
            }
            {projectData.associatedBlog && 
                <span class="info">{projectData.associatedBlog}</span>
            }
            {projectData.techStack && 
                <span class="info">{projectData.techStack}</span>
            }
            <div class="description-holder">
                <span class="description">{projectData.description}</span>
            </div>
        </div>
    </div>
    <div class="project-media">
        <div class="demo-holder">
            <img class="demo-media" src={projectData.demoImage} alt="No Image"/>
        </div>
        <div class="link-holder">
            {projectData.githubLink && 
                <a href={projectData.githubLink} class="info" target="_blank">GITHUB</a>
            }
            {projectData.projectLink && 
                <a href={projectData.projectLink} class="info" target="_blank">PROJECT</a>
            }
        </div>
    </div>
</div>

<style>
.project-container {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
}
.project-info {
    display: flex;
    flex: 1;
    border: 2px solid white;
    margin: 1rem;
    margin-bottom: 0rem;
}
.logo-holder {
    flex: 1;
    display: flex;
    border-right: 2px solid white;
    justify-content: center;
    align-items: center;
}
.logo-image {
    display: block;
    width: 80%;
    aspect-ratio: 1/1;
    object-fit: cover;
}
.info-holder {
    flex: 1;
    display: flex;
    flex-direction: column;
    border-left: 2px solid white;
}
.project-media {
    display: flex;
    flex: 1;
    border: 2px solid white;
    margin: 1rem;
    margin-top: 0rem;
}
.demo-holder {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    border-right: 2px solid white;
}
.demo-media {
    display: block;
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    object-position: top left;
}
.link-holder {
    flex: 1;
    border-left: 2px solid white;
}
</style>