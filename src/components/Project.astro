---
import { render} from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'project'>;
}

const { project } = Astro.props;

const projectData = project.data;

const { Content } = await render(project)
---

<div class="project-container">
    <div class="project-info">
        <div class="logo-holder">
            <img class="logo-image" src={projectData.projectIcon} alt="No Image"/>
        </div>
        <div class="info-holder">
            {projectData.title && 
                <div class="info-block">
                    <span class="info">Title:</span>
                    <span class="info">{projectData.title}</span>
                </div>
            }
            {projectData.projectType && 
                <div class="info-block">
                    <span class="info">Type:</span>
                    <span class="info">{projectData.projectType}</span>
                </div>
            }
            {projectData.associatedBlog && 
                <div class="info-block">
                    <span class="info">Blog Post:</span>
                    <span class="info">{projectData.associatedBlog}</span>
                </div>
            }
            {projectData.techStack && 
                <div class="info-block">
                    <span class="info">Tech Stack:</span>
                    <span class="info">{projectData.techStack}</span>
                </div>
            }
            <div class="description-holder">
                <!-- <span class="description">{projectData.description}</span> -->
                <Content/>
            </div>
        </div>
    </div>
    <div class="project-media">
        <div class="demo-holder">
            <img class="demo-media" src={projectData.demoImage} alt="No Image"/>
        </div>
        <div class="link-holder">
            {projectData.githubLink && 
                <a href={projectData.githubLink} class="github" target="_blank">GITHUB</a>
            }
            {projectData.projectLink && 
                <a href={projectData.projectLink} class="project" target="_blank">PROJECT</a>
            }
        </div>
    </div>
</div>

<style>
.project-container {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
}
.project-info {
    display: flex;
    flex: .5;
    border: 2px solid white;
    margin: 1rem;
    margin-bottom: 0rem;
}
.logo-holder {
    flex: 1;
    display: flex;
    border-right: 2px solid white;
    justify-content: center;
    align-items: center;
}
.logo-image {
    display: block;
    width: 80%;
    aspect-ratio: 1/1;
    object-fit: cover;
}
.info-holder {
    flex: 1;
    padding: .5rem;
    display: flex;
    font-size: 1.5rem;
    flex-direction: column;
    color: white;
    border-left: 2px solid white;
}
.info-block {
    display: flex;
    justify-content: space-between;
    align-items: center;
    line-height: 1.2;
    border-bottom: 4px solid white;
}
.description-holder {
    display: flex;
    flex: 1;
    max-height: 353px;
    flex-direction: column;
    color: var(--yellow);
    font-size: 1rem;
    border: 4px solid white;
    margin-top: .5rem;
    padding: .3rem;
    min-height: 0;
    overflow-y: scroll;
}
.project-media {
    display: flex;
    flex: .5;
    border: 2px solid white;
    margin: 1rem;
    margin-top: 0rem;
}
.demo-holder {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    border-right: 2px solid white;
}
.demo-media {
    display: block;
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    object-position: top left;
}
.link-holder {
    display: flex;
    flex: 1;
    flex-direction: column;
    border-left: 2px solid white;
    padding: .5rem;
}
.link-holder a{
    font-size: 1.5rem;
    padding: 0rem;
    text-decoration: none;
}
.github {
    color: rgb(28, 230, 21);
}
.project {
    color: var(--yellow);
}
</style>