---
const { collapsableID, isOpen=false, dropdownName="click me" } = Astro.props;
---
<div class="dropdown">
    <div class="dropdown-tab">
      <button class="dropdown-button" dropdown-toggle={collapsableID} data-role="dropdown-button">
          <img id="dropdown-image" class="image-closed" src="/triangle.png" data-open={isOpen}/>
          <span class="button-text">{dropdownName}</span>
      </button>
    </div>
    <div id={collapsableID} class="dropdown-content" data-open={isOpen}>
        <slot></slot>
    </div>
</div>

<style>
  .dropdown {
    border: 1px solid white;
    margin: .2rem;
  }
  .dropdown-tab {
    display: flex;
  }
  .image-closed {
    width: 20px;
    transform: rotate(180deg);
    margin: .5rem 1rem .5rem .4rem;
  }
  .image-expanded {
    width: 20px;
    transform: rotate(225deg);
    margin: .8rem 1.7rem .2rem .8rem;
    padding: 0rem;
  }
  .dropdown-button {
    display: flex;
    align-items: center;
    color: white;
    font-family: inherit;
    flex: 1;
    background: none;
    font-size: 1.4rem;
    border: none;
    cursor: pointer;
  }
  .dropdown-button:active .button-text {
    transform: translateY(1px);
  }
  .button-text {
    text-align: center;
  }
  .dropdown-content[data-open="false"] {
    display: none;
  }
  .dropdown-content {
    border: 1px solid white;
    margin: .0rem 1rem .6rem;
  }
</style>

<script>
    document.querySelectorAll('[data-role="dropdown-button"]').forEach(button => {
        const collapsableID = button.getAttribute("dropdown-toggle") ?? "";
        const content = document.getElementById(collapsableID);
        const image = button.querySelector('#dropdown-image') as HTMLImageElement | null;
        if (content && image) {
            const isExpandedOnLoad = content.getAttribute('data-open') === 'true';
            image.src = isExpandedOnLoad ? 'ourple_triangle.png': 'triangle.png';
            image.className = isExpandedOnLoad ? 'image-expanded' : 'image-closed';
            // button.className = isExpandedOnLoad ? 'dropdown-button-expanded' : 'dropdown-button-closed';
            button.addEventListener('click', () => {
                if (content && image) {
                    const isExpanded = content.getAttribute('data-open') === 'true';
                    image.src = isExpanded ? 'triangle.png': 'ourple_triangle.png';
                    image.className = isExpanded ? 'image-closed' : 'image-expanded';
                    // button.className = isExpanded ? 'dropdown-button-closed' : 'dropdown-button-expanded';
                    content.setAttribute('data-open', (!isExpanded).toString());
                }
            });
          }
    })
</script>